@charset "utf-8";

:root { --navy: #17324d; --teal: #26788a; --bg: #f4f7fb; --ink: #1d2b3a; --=
muted: #667789; --line: #dbe4ec; --white: #fff; }

* { box-sizing: border-box; }

body { margin: 0px; font-family: Inter, "Segoe UI", Arial, sans-serif; back=
ground: var(--bg); color: var(--ink); }

header { background: linear-gradient(120deg, rgb(23, 50, 77), rgb(38, 120, =
138)); color: rgb(255, 255, 255); padding: 28px clamp(16px, 4vw, 48px); }

header h1 { margin: 0px 0px 8px; font-size: clamp(24px, 3vw, 36px); }

header p { margin: 0px; color: rgb(225, 237, 244); }

main { max-width: 1400px; margin: auto; padding: 22px clamp(12px, 3vw, 32px=
) 48px; }

.notice { background: rgb(255, 248, 231); border: 1px solid rgb(239, 219, 1=
67); color: rgb(107, 84, 32); padding: 12px 14px; border-radius: 10px; marg=
in-bottom: 18px; font-size: 14px; }

.filters { display: flex; flex-wrap: wrap; gap: 12px; align-items: end; bac=
kground: rgb(255, 255, 255); padding: 16px; border: 1px solid var(--line); =
border-radius: 14px; margin-bottom: 18px; }

label { display: flex; flex-direction: column; gap: 6px; font-size: 12px; c=
olor: var(--muted); font-weight: 700; }

select, input, button { font: inherit; border: 1px solid rgb(203, 215, 226)=
; border-radius: 8px; padding: 9px 11px; background: rgb(255, 255, 255); co=
lor: var(--ink); }

button { cursor: pointer; background: var(--navy); color: rgb(255, 255, 255=
); border-color: var(--navy); }

button.secondary { background: rgb(255, 255, 255); color: var(--navy); }

.kpis { display: grid; grid-template-columns: repeat(4, minmax(0px, 1fr)); =
gap: 14px; margin-bottom: 18px; }

.kpi, .panel { background: rgb(255, 255, 255); border: 1px solid var(--line=
); border-radius: 14px; padding: 17px; box-shadow: rgba(23, 50, 77, 0.035) =
0px 2px 8px; }

.kpi .label { font-size: 12px; color: var(--muted); font-weight: 700; }

.kpi .value { font-size: clamp(22px, 2.5vw, 30px); font-weight: 800; color:=
 var(--navy); margin: 8px 0px 3px; }

.kpi .sub { font-size: 12px; color: var(--muted); }

.grid { display: grid; grid-template-columns: repeat(2, minmax(0px, 1fr)); =
gap: 16px; }

.panel h2 { font-size: 16px; margin: 0px 0px 4px; color: var(--navy); }

.panel p { font-size: 12px; color: var(--muted); margin: 0px 0px 12px; }

canvas { width: 100%; height: 280px; display: block; }

.wide { grid-column: 1 / -1; }

table { border-collapse: collapse; width: 100%; font-size: 13px; }

th, td { text-align: left; padding: 10px 8px; border-bottom: 1px solid var(=
--line); }

th { color: var(--muted); font-size: 11px; text-transform: uppercase; lette=
r-spacing: 0.04em; }

td.num { text-align: right; font-variant-numeric: tabular-nums; }

.funnel { display: grid; gap: 9px; }

.funnel-row { display: grid; grid-template-columns: 150px 1fr 70px; gap: 10=
px; align-items: center; font-size: 12px; }

.barbg { background: rgb(237, 242, 247); border-radius: 7px; height: 22px; =
overflow: hidden; }

.bar { height: 100%; background: linear-gradient(90deg, rgb(38, 120, 138), =
rgb(74, 164, 173)); border-radius: 7px; }

.drop { color: rgb(160, 75, 59); text-align: right; font-variant-numeric: t=
abular-nums; }

.footer { font-size: 12px; color: var(--muted); margin-top: 18px; }

@media (max-width: 800px) {
  .kpis { grid-template-columns: repeat(2, minmax(0px, 1fr)); }
  .grid { grid-template-columns: 1fr; }
  .wide { grid-column: auto; }
  .funnel-row { grid-template-columns: 115px 1fr 56px; }
  canvas { height: 250px; }
}

@media print {
  body { background: rgb(255, 255, 255); }
  .filters, button { display: none; }
  .panel, .kpi { box-shadow: none; break-inside: avoid; }
  header { print-color-adjust: exact; background: rgb(23, 50, 77) !importan=
t; }
}
